<script>
document.addEventListener("DOMContentLoaded", () => {
  // Preloader
  const preloader = document.querySelector('.preloader');
  if (preloader) {
    setTimeout(() => {
      preloader.classList.add('fade-out');
      setTimeout(() => {
        preloader.style.display = 'none';
      }, 500);
    }, 1000);
  }

  // ---- Mobile menu toggle ----
  const menuBtn = document.getElementById("menuBtn");
  const mobileMenu = document.getElementById("mobileMenu");
  if (menuBtn && mobileMenu) {
    menuBtn.addEventListener("click", () => {
      mobileMenu.classList.toggle("open");
      menuBtn.setAttribute("aria-expanded", mobileMenu.classList.contains("open"));
    });
  }

  // ---- Pricing toggle (Monthly/Annual) ----
  const toggle = document.getElementById("billingToggle");
  const dot = document.getElementById("toggleDot");
  const monthlyText = document.getElementById("monthlyText");
  const annualText = document.getElementById("annualText");
  let annual = false;
  const priceEls = [...document.querySelectorAll("[data-monthly]")];

  function applyPricing() {
    priceEls.forEach((el) => {
      el.textContent = annual
        ? el.dataset.annual
        : el.dataset.monthly;
    });
    if (dot) {
      dot.style.transform = annual ? "translateX(2.5rem)" : "translateX(0)";
    }
    if (monthlyText && annualText) {
      monthlyText.style.opacity = annual ? "0.7" : "1";
      annualText.style.opacity = annual ? "1" : "0.7";
    }
  }

  if (toggle) {
    toggle.addEventListener("click", () => {
      annual = !annual;
      applyPricing();
    });
  }
  applyPricing();

  // ---- Video background URL support ----
  (() => {
    const hero = document.getElementById("hero");
    if (!hero) return;

    let video = document.getElementById("bgVideo");
    if (!video) {
      video = document.createElement("video");
      video.id = "bgVideo";
      video.autoplay = true;
      video.loop = true;
      video.muted = true;
      video.playsInline = true;
      hero.prepend(video);
    }

    const params = new URLSearchParams(window.location.search);
    const queryUrl = params.get("video");
    const dataUrl = hero.getAttribute("data-video-url");

    // Must be actual MP4 (or WebM) video links
    const defaultVideo = "https://motionbgs.com/media/7498/earth-from-space.1920x1080.mp4";
    const fallbackVideo = "https://motionbgs.com/media/530/by-the-fire-minecraft.1920x1080.mp4";

    const src = queryUrl || dataUrl || defaultVideo;

    video.innerHTML = ""; // Remove old sources
    const source = document.createElement("source");
    source.src = src;
    source.type = "video/mp4";
    video.appendChild(source);

    video.load();
    video.play().catch(() => {
      console.warn("Autoplay blocked — muting and retrying.");
      video.muted = true;
      video.play().catch(() => {
        console.error("Video still couldn't play, switching to fallback.");
        video.innerHTML = "";
        const fallbackSource = document.createElement("source");
        fallbackSource.src = fallbackVideo;
        fallbackSource.type = "video/mp4";
        video.appendChild(fallbackSource);
        video.load();
        video.play().catch(() =>
          console.error("Fallback video also failed to play.")
        );
      });
    });
  })();

  // ---- Year ----
  const yearEl = document.getElementById("year");
  if (yearEl) {
    yearEl.textContent = new Date().getFullYear();
  }
  
  // ---- Smooth scrolling for anchor links ----
  document.querySelectorAll('a[href^="#"]').forEach(anchor => {
    anchor.addEventListener('click', function (e) {
      e.preventDefault();
      
      const targetId = this.getAttribute('href');
      if (targetId === '#') return;
      
      const targetElement = document.querySelector(targetId);
      if (targetElement) {
        targetElement.scrollIntoView({
          behavior: 'smooth'
        });
        
        // Update URL without jumping
        if (history.pushState) {
          history.pushState(null, null, targetId);
        } else {
          location.hash = targetId;
        }
      }
    });
  });

  // ---- Back to top button ----
  const backToTopBtn = document.getElementById('backToTop');
  if (backToTopBtn) {
    window.addEventListener('scroll', () => {
      if (window.pageYOffset > 300) {
        backToTopBtn.classList.remove('opacity-0', 'invisible', 'translate-y-4');
        backToTopBtn.classList.add('opacity-100', 'visible', 'translate-y-0');
      } else {
        backToTopBtn.classList.add('opacity-0', 'invisible', 'translate-y-4');
        backToTopBtn.classList.remove('opacity-100', 'visible', 'translate-y-0');
      }
    });

    backToTopBtn.addEventListener('click', () => {
      window.scrollTo({
        top: 0,
        behavior: 'smooth'
      });
    });
  }

  // ---- Tab system ----
  const tabButtons = document.querySelectorAll('.tab-btn');
  const tabPanes = document.querySelectorAll('.tab-pane');

  tabButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      // Remove active from all buttons
      tabButtons.forEach(b => {
        b.classList.remove('active');
        b.classList.remove('bg-primary-500');
        b.classList.add('bg-white/10');
      });

      // Add active to clicked button
      btn.classList.add('active', 'bg-primary-500');
      btn.classList.remove('bg-white/10');

      // Hide all panes
      tabPanes.forEach(p => p.classList.remove('active'));

      // Show clicked pane
      const target = btn.getAttribute('data-tab');
      const pane = document.getElementById(target);
      if (pane) {
        pane.classList.add('active');
      }
    });
  });

  // First tab active by default
  if (tabButtons.length > 0 && tabPanes.length > 0) {
    tabButtons[0].classList.add('active', 'bg-primary-500');
    tabPanes[0].classList.add('active');
  }
  
  // ---- Services Tab system ----
  const servicesTabButtons = document.querySelectorAll('.services-tab-btn');
  const servicesContents = document.querySelectorAll('.services-content');

  servicesTabButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      // Remove active from all buttons
      servicesTabButtons.forEach(b => {
        b.classList.remove('active');
      });

      // Add active to clicked button
      btn.classList.add('active');

      // Hide all contents
      servicesContents.forEach(content => content.classList.remove('active'));

      // Show clicked content
      const target = btn.getAttribute('data-tab');
      const content = document.getElementById(`${target}-tab`);
      if (content) {
        content.classList.add('active');
      }
    });
  });

  // First tab active by default
  if (servicesTabButtons.length > 0 && servicesContents.length > 0) {
    servicesTabButtons[0].classList.add('active');
    servicesContents[0].classList.add('active');
  }

  // ---- Intersection Observer for animations ----
  const animateElements = document.querySelectorAll('.animate-fade-in-up');
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('animate-fadeInUp');
        observer.unobserve(entry.target);
      }
    });
  }, {
    threshold: 0.1
  });

  animateElements.forEach(el => {
    observer.observe(el);
  });

  // ---- Tooltip initialization ----
  const tooltipTriggers = document.querySelectorAll('.tooltip');
  tooltipTriggers.forEach(trigger => {
    trigger.addEventListener('mouseenter', () => {
      const tooltip = trigger.querySelector('.tooltip-text');
      if (tooltip) {
        tooltip.style.visibility = 'visible';
        tooltip.style.opacity = '1';
      }
    });
    trigger.addEventListener('mouseleave', () => {
      const tooltip = trigger.querySelector('.tooltip-text');
      if (tooltip) {
        tooltip.style.visibility = 'hidden';
        tooltip.style.opacity = '0';
      }
    });
  });
  
  // ---- Server status indicator ----
  function updateServerStatus() {
    fetch('https://api.unixnodes.com/status')
      .then(response => response.json())
      .then(data => {
        const statusElements = document.querySelectorAll('.server-status');
        statusElements.forEach(el => {
          const statusClass = data.status === 'up' ? 'status-up' : 
                            data.status === 'down' ? 'status-down' : 'status-warning';
          el.className = `status-indicator ${statusClass}`;
          el.title = data.message || 'Server status';
        });
      })
      .catch(() => {
        console.log('Unable to fetch server status');
      });
  }
  
  // Update status every 5 minutes
  updateServerStatus();
  setInterval(updateServerStatus, 300000);
  
  // ---- UnixNodes terminal animation ----
  const terminalCommands = [
    {command: 'sudo apt-get update', output: 'Reading package lists... Done'},
    {command: 'sudo apt-get install minecraft-server', output: 'Installing dependencies... Done'},
    {command: 'systemctl start minecraft', output: 'Minecraft server started on port 25565'},
    {command: 'systemctl status minecraft', output: '● minecraft.service - Minecraft Server\n   Loaded: loaded (/etc/systemd/system/minecraft.service; enabled; vendor preset: enabled)\n   Active: active (running) since Sun 2023-06-18 14:30:45 UTC; 5s ago'}
  ];
  
  const terminalElement = document.querySelector('.unixnodes-terminal-body');
  if (terminalElement) {
    let currentCommand = 0;
    
    function typeTerminal() {
      if (currentCommand < terminalCommands.length) {
        const cmd = terminalCommands[currentCommand];
        terminalElement.innerHTML += `<div class="unixnodes-terminal-command">$ ${cmd.command}</div>`;
        
        let i = 0;
        const typing = setInterval(() => {
          if (i < cmd.output.length) {
            terminalElement.innerHTML += cmd.output.charAt(i);
            terminalElement.scrollTop = terminalElement.scrollHeight;
            i++;
          } else {
            clearInterval(typing);
            terminalElement.innerHTML += '\n\n';
            currentCommand++;
            setTimeout(typeTerminal, 1000);
          }
        }, 20);
      } else {
        // Loop the animation
        currentCommand = 0;
        terminalElement.innerHTML = '';
        setTimeout(typeTerminal, 1000);
      }
    }
    
    // Start the animation
    typeTerminal();
  }
});
</script>
</body>
</html>