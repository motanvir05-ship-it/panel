<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>UnixNodes - Premium AMD VPS Hosting</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css"/>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🖥️</text></svg>">
    <style>
        :root {
            --primary: #ED1C24; /* AMD Red */
            --primary-dark: #C0171D;
            --secondary: #00A0E3; /* AMD Blue */
            --dark: #f5f6fa;
            --light: #1a2030;
            --success: #10b981;
            --warning: #f59e0b;
            --danger: #ef4444;
            --card-bg: #252f3f;
            --card-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
            --transition: all 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
            --gradient: linear-gradient(135deg, var(--primary), var(--secondary));
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
        }

        body {
            background-color: #131a28;
            color: var(--dark);
            overflow-x: hidden;
            background-image: 
                radial-gradient(circle at 10% 20%, rgba(237, 28, 36, 0.1) 0%, transparent 20%),
                radial-gradient(circle at 90% 80%, rgba(0, 160, 227, 0.1) 0%, transparent 20%);
        }

        .header {
            background: rgba(19, 26, 40, 0.95);
            backdrop-filter: blur(10px);
            padding: 1rem 2rem;
            position: sticky;
            top: 0;
            z-index: 100;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        }

        .header-content {
            max-width: 1600px;
            margin: 0 auto;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 0.8rem;
            text-decoration: none;
        }

        .logo-icon {
            font-size: 2rem;
            color: var(--primary);
        }

        .logo-text {
            font-size: 1.5rem;
            font-weight: 700;
            background: var(--gradient);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }

        .nav-links {
            display: flex;
            gap: 2rem;
        }

        .nav-links a {
            color: var(--dark);
            text-decoration: none;
            font-weight: 500;
            transition: var(--transition);
        }

        .nav-links a:hover {
            color: var(--primary);
        }

        .menu-toggle {
            display: none;
            flex-direction: column;
            justify-content: space-around;
            width: 2rem;
            height: 2rem;
            background: transparent;
            border: none;
            cursor: pointer;
            padding: 0;
            z-index: 10;
        }

        .menu-toggle span {
            width: 2rem;
            height: 0.25rem;
            background: var(--dark);
            border-radius: 10px;
            transition: all 0.3s linear;
            position: relative;
            transform-origin: 1px;
        }

        .services-container {
            padding: 4rem 1rem;
            max-width: 1600px;
            margin: 0 auto;
        }

        .section-title {
            text-align: center;
            margin-bottom: 3rem;
            position: relative;
        }

        .section-title h2 {
            font-size: 2.5rem;
            background: linear-gradient(90deg, var(--primary), var(--secondary));
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            margin-bottom: 1rem;
            font-weight: 800;
            letter-spacing: -0.5px;
        }

        .section-title p {
            color: #a0a8c0;
            font-size: 1.1rem;
            max-width: 800px;
            margin: 0 auto;
            line-height: 1.6;
        }

        .service-cards {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 2rem;
            margin-top: 2rem;
        }

        .service-card {
            background: var(--card-bg);
            border-radius: 16px;
            padding: 2rem;
            box-shadow: var(--card-shadow);
            transition: var(--transition);
            position: relative;
            overflow: hidden;
            z-index: 1;
            border: 1px solid rgba(255, 255, 255, 0.05);
            display: flex;
            flex-direction: column;
            height: 100%;
        }

        .service-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 5px;
            background: var(--gradient);
            z-index: 2;
        }

        .service-card::after {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: radial-gradient(circle at 50% 0%, rgba(237, 28, 36, 0.1) 0%, transparent 70%);
            z-index: -1;
            opacity: 0;
            transition: var(--transition);
        }

        .service-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.4);
        }

        .service-card:hover::after {
            opacity: 1;
        }

        .service-card h3 {
            font-size: 1.5rem;
            margin-bottom: 1.2rem;
            color: var(--primary);
            text-align: center;
            position: relative;
            padding-bottom: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .service-card h3 i {
            margin-right: 10px;
            font-size: 1.3rem;
        }

        .service-card h3::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 50%;
            transform: translateX(-50%);
            width: 50px;
            height: 3px;
            background: var(--gradient);
            border-radius: 3px;
        }

        .price {
            font-size: 2.2rem;
            font-weight: 800;
            color: var(--dark);
            text-align: center;
            margin: 1.5rem 0;
            position: relative;
            display: flex;
            align-items: flex-start;
            justify-content: center;
        }

        .price span {
            font-size: 1rem;
            font-weight: 400;
            color: #a0a8c0;
            margin-top: 0.4rem;
            margin-left: 0.2rem;
        }

        .service-features {
            list-style: none;
            margin-bottom: 2rem;
            flex-grow: 1;
        }

        .service-features li {
            padding: 0.8rem 0;
            border-bottom: 1px dashed rgba(255, 255, 255, 0.1);
            display: flex;
            align-items: center;
            color: #e0e4ed;
            font-size: 0.95rem;
            transition: var(--transition);
        }

        .service-features li:hover {
            color: white;
            transform: translateX(5px);
        }

        .service-features li:last-child {
            border-bottom: none;
        }

        .service-features li i {
            margin-right: 10px;
            color: var(--success);
            font-size: 1rem;
            min-width: 20px;
        }

        .btn {
            display: inline-block;
            padding: 0.9rem 1.2rem;
            border-radius: 50px;
            text-align: center;
            text-decoration: none;
            font-weight: 600;
            transition: var(--transition);
            width: 100%;
            border: none;
            cursor: pointer;
            font-size: 1rem;
            position: relative;
            overflow: hidden;
            z-index: 1;
        }

        .btn-primary {
            background: var(--gradient);
            color: white;
            box-shadow: 0 4px 15px rgba(237, 28, 36, 0.4);
        }

        .btn-primary:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(237, 28, 36, 0.6);
        }

        .popular-tag {
            position: absolute;
            top: 20px;
            right: -35px;
            background: var(--gradient);
            color: white;
            padding: 0.3rem 2.5rem;
            font-size: 0.8rem;
            font-weight: 700;
            transform: rotate(45deg);
            box-shadow: 0 2px 12px rgba(0, 160, 227, 0.4);
            z-index: 3;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .best-value-ribbon {
            position: absolute;
            top: 12px;
            left: -5px;
            background: var(--gradient);
            color: white;
            padding: 0.4rem 1.2rem;
            font-size: 0.7rem;
            font-weight: 700;
            box-shadow: 0 2px 12px rgba(237, 28, 36, 0.4);
            z-index: 3;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            clip-path: polygon(0 0, 100% 0, 90% 50%, 100% 100%, 0 100%, 10% 50%);
        }

        .performance-meter {
            height: 5px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 3px;
            margin: 1.2rem 0;
            overflow: hidden;
        }

        .performance-bar {
            height: 100%;
            background: var(--gradient);
            border-radius: 3px;
            transition: width 1s ease-in-out;
        }

        .amd-badge {
            display: inline-block;
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            color: white;
            padding: 0.3rem 0.8rem;
            border-radius: 4px;
            font-size: 0.7rem;
            font-weight: 600;
            margin-top: 0.5rem;
        }

        .footer {
            background: var(--card-bg);
            padding: 3rem 2rem;
            margin-top: 4rem;
            border-top: 1px solid rgba(255, 255, 255, 0.05);
        }

        .footer-content {
            max-width: 1600px;
            margin: 0 auto;
            text-align: center;
        }

        .footer p {
            color: #a0a8c0;
            margin-bottom: 1rem;
        }

        .footer-links {
            display: flex;
            justify-content: center;
            gap: 2rem;
            margin-top: 1.5rem;
        }

        .footer-links a {
            color: var(--secondary);
            text-decoration: none;
            transition: var(--transition);
        }

        .footer-links a:hover {
            color: var(--primary);
        }

        /* Mobile Responsiveness */
        @media (max-width: 768px) {
            .header {
                padding: 1rem;
            }
            
            .nav-links {
                display: none;
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100vh;
                background: rgba(19, 26, 40, 0.98);
                flex-direction: column;
                justify-content: center;
                align-items: center;
                z-index: 9;
                gap: 2rem;
            }
            
            .nav-links.active {
                display: flex;
            }
            
            .menu-toggle {
                display: flex;
                z-index: 10;
            }
            
            .menu-toggle.active span:nth-child(1) {
                transform: rotate(45deg);
            }
            
            .menu-toggle.active span:nth-child(2) {
                opacity: 0;
            }
            
            .menu-toggle.active span:nth-child(3) {
                transform: rotate(-45deg);
            }

            .services-container {
                padding: 2rem 1rem;
            }

            .section-title h2 {
                font-size: 2rem;
            }

            .section-title p {
                font-size: 0.95rem;
                padding: 0 1rem;
            }

            .service-cards {
                grid-template-columns: 1fr;
                gap: 1.5rem;
            }

            .service-card {
                padding: 1.5rem;
            }

            .price {
                font-size: 1.8rem;
            }

            .popular-tag {
                right: -38px;
                padding: 0.25rem 2.2rem;
                font-size: 0.7rem;
            }
            
            .service-features li {
                font-size: 0.9rem;
                padding: 0.7rem 0;
            }
            
            .footer-links {
                flex-direction: column;
                gap: 1rem;
            }
        }

        @media (max-width: 480px) {
            .section-title h2 {
                font-size: 1.8rem;
            }
            
            .service-card {
                padding: 1.2rem;
            }
            
            .service-card h3 {
                font-size: 1.3rem;
            }
            
            .price {
                font-size: 1.6rem;
            }
        }

        /* Custom animations */
        @keyframes float {
            0%, 100% {
                transform: translateY(0);
            }
            50% {
                transform: translateY(-8px);
            }
        }

        @keyframes pulse {
            0%, 100% {
                transform: scale(1);
                box-shadow: 0 4px 15px rgba(237, 28, 36, 0.4);
            }
            50% {
                transform: scale(1.03);
                box-shadow: 0 8px 25px rgba(237, 28, 36, 0.6);
            }
        }

        .float-animation {
            animation: float 4s ease-in-out infinite;
        }

        .pulse-animation {
            animation: pulse 2s ease-in-out infinite;
        }
    </style>
</head>
<body>
